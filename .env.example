# MacBuddy environment configuration template.
#
# In the real deployment, each service has its own .env file. This combined
# template shows every value the system reads. Copy what's relevant into
# the appropriate service folder.

# ============================================================================
# ROUTER (port 8000)
# ============================================================================

# Local Ollama URL for Gemma intent classifier
OLLAMA_URL=http://localhost:11434
GEMMA_MODEL=gemma3:4b

# MongoDB Atlas connection for audit logging (optional)
MONGO_URI=

# Lane URLs
FACETIME_LANE_URL=http://localhost:8003
ORBIT_LANE_URL=http://localhost:8001

# ============================================================================
# FACETIME LANE (port 8003)
# ============================================================================

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_ITERATIONS=12

# Backend selector: claude | groq | gemini
BACKEND=claude

GROQ_API_KEY=
GEMINI_API_KEY=

# ============================================================================
# ORBIT LANE (port 8001)
# ============================================================================

GROQ_API_KEY=

# Google OAuth (Drive, Gmail, Calendar scopes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/oauth/callback

# ============================================================================
# VOICE DAEMON (port 8004)
# ============================================================================

GROQ_API_KEY=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Audio device selection
INPUT_DEVICE=4
OUTPUT_DEVICE=BlackHole 16ch

# ============================================================================
# IMESSAGE BRIDGE
# ============================================================================

ROUTER_URL=http://localhost:8000
VOICE_DAEMON_URL=http://localhost:8004
POLL_INTERVAL=2.0

# Comma-separated list of phone numbers and emails allowed to send commands.
# Include country code for phones. Empty = lock everyone out.
ALLOWED_SENDERS=

# Speak iMessage replies aloud through Mac speakers via ElevenLabs
SPEAK_REPLIES=1
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ============================================================================
# AGENTVERSE WRAPPER (port 8005)
# ============================================================================

ROUTER_URL=http://localhost:8000

# Get an API key at https://agentverse.ai (Profile -> API Keys)
AGENTVERSE_API_KEY=
AGENTVERSE_KEY=

# Random hex string. Same seed across restarts = same agent address.
AGENTVERSE_SEED=
AGENT_SEED_PHRASE=

# Public name shown in Agentverse marketplace
AGENTVERSE_NAME=MacBuddy

# Local port the agent listens on
AGENTVERSE_PORT=8005

# Public ngrok URL with /submit appended.
# Example: https://abc123.ngrok-free.dev/submit
AGENTVERSE_ENDPOINT=

# Comma-separated list of agent addresses allowed to send commands via
# ASI:One / Agentverse. Get your own from https://asi1.ai profile.
ALLOWED_SENDERS=
